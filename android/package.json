{
  "name": "guyunusa-android",
  "version": "1.3.1",
  "description": "Guyunusa Android — wrapper Capacitor",
  "private": true,
  "scripts": {
    "cap:init":  "node node_modules/@capacitor/cli/bin/capacitor init",
    "cap:add":   "node node_modules/@capacitor/cli/bin/capacitor add android",
    "cap:sync":  "node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:open":  "node node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:run":   "node node_modules/@capacitor/cli/bin/capacitor run android",
    "cap:build": "node node_modules/@capacitor/cli/bin/capacitor build android",
    "icons":   "node scripts/generate-icons.js",
    "sync":    "node node_modules/@capacitor/cli/bin/capacitor sync android && node scripts/generate-icons.js",
    "mapping": "node -e \"const p='android/app/build/outputs/mapping/release/mapping.txt';const fs=require('fs');if(fs.existsSync(p)){console.log('mapping.txt encontrado en:','\\n  '+require('path').resolve(p));}else{console.log('No encontrado. Compilá el release AAB primero: Gradle → app → Tasks → bundle → bundleRelease');}\" "
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^4.1.1",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
