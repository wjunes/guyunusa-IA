{
  "name": "guyunusa-backend",
  "version": "1.0.0",
  "description": "Backend de Guyunusa — IA con identidad uruguaya",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check-env.js",
    "db:reset": "node scripts/db-reset.js",
    "migrate": "node src/db/migrations.js",
    "update:domain": "node scripts/update-knowledge.js domain",
    "update:all": "node scripts/update-knowledge.js all",
    "update:source": "node scripts/update-knowledge.js source",
    "update:test": "node scripts/update-knowledge.js test",
    "update:stats": "node scripts/update-knowledge.js stats",
    "update:domains": "node scripts/update-knowledge.js list-domains",
    "review": "node scripts/review-candidates.js",
    "test:knowledge": "node test/knowledge-updater/change-detector.test.js && node test/knowledge-updater/evaluator.test.js && node test/knowledge-updater/candidate-manager.test.js && node test/knowledge-updater/scheduler.test.js",
    "test:change-detector": "node test/knowledge-updater/change-detector.test.js",
    "test:evaluator": "node test/knowledge-updater/evaluator.test.js",
    "test:candidates": "node test/knowledge-updater/candidate-manager.test.js",
    "test:scheduler": "node test/knowledge-updater/scheduler.test.js",
    "test:env-guard": "node test/knowledge-updater/env-guard.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mercadopago": "^3.2.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.6",
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
